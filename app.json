{
  "expo": {
    "name": "Halpal",
    "slug": "halpal",
    "scheme": "halpal",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FCF2E5",
    "ios": {
      "bundleIdentifier": "com.halpal.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.halpal.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F1ECE0"
      }
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FCF2E5"
        }
      ]
    ]
  }
}
